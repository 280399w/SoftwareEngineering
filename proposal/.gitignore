# ==========================================
# LaTeX 中間ファイル・ビルド生成物
# ==========================================
*.aux
*.log
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.bbl
*.blg
*.out
*.nav
*.snm
*.vrb
*.dvi
*.bcf
*.run.xml

# ==========================================
# 最終生成物（PDF）
# Git上での自動ビルドを基本とするため除外
# ==========================================
*.pdf

# ただし、挿入用画像として使っているPDFファイルは追跡対象に含める
!images/*.pdf
!figures/*.pdf

# ==========================================
# OS・エディタの一時ファイル
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/